// The complete HarfBuzz row is rasterized once into a 2x transparent texture.
// Playback changes only the independently timed vertical offset selected here;
// shaping and source rasterization never happen on the frame path.
uniform shader content;
uniform float4 segments[128]; // logical x0, x1, vertical offset, reserved
uniform int segmentCount;
uniform float4 wordLifts[32]; // word x0, x1, peak lift, lyric progress/crest phase
uniform int wordLiftCount;
uniform float2 sourceOrigin;  // logical top-left of the cached texture
uniform float sourceScale;    // logical -> source pixels (currently 2.0)

half4 main(float2 p) {
    float lift = 0.0;
    for (int i = 0; i < 128; ++i) {
        if (i >= segmentCount) break;
        float4 segment = segments[i];
        if (p.x >= segment.x && p.x < segment.y) {
            lift = segment.z;
            break;
        }
    }

    // Sustained display words receive a small extra displacement over their
    // independently timed syllable lift. This is one positive half-sine pulse:
    // its crest is pinned to the karaoke sweep position (word.w), so its phase
    // follows the real lyric progress without introducing an independent clock.
    for (int i = 0; i < 32; ++i) {
        if (i >= wordLiftCount) break;
        float4 word = wordLifts[i];
        if (p.x >= word.x && p.x <= word.y) {
            float u = clamp((p.x - word.x) / max(0.001, word.y - word.x), 0.0, 1.0);
            // A full normalized word is the width of the half-period. Moving its
            // centre with word.w keeps the current lyric position at sin(pi/2),
            // while values outside the positive half-period remain undeformed.
            float phase = u - word.w + 0.5;
            if (phase >= 0.0 && phase <= 1.0) {
                lift += word.z * sin(phase * 3.14159265);
            }
            break;
        }
    }

    // A negative lift moves output upward: an output pixel samples a lower point
    // in the 2x source texture. At this mapping an output-pixel centre lands between
    // the corresponding 2x2 source pixels; the LINEAR image child blends that full
    // neighbourhood in one lookup. Fractional lift remains in the continuous source
    // coordinate, preserving sub-pixel movement without Catmull-Rom sharpening/ringing.
    float2 logicalSource = float2(p.x, p.y - lift) - sourceOrigin;
    float2 source = logicalSource * sourceScale;
    return content.eval(source);
}
